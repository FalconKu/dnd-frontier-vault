{
  "schema_version": 1,
  "content_schema_version": 2,
  "locale_schema_version": 1,
  "default_locale": "zh-CN",
  "supported_locales": [
    "zh-CN"
  ],
  "id": "dnd-frontier-vault",
  "name": "霜脊边地：边镇资料集",
  "version": "1.0.3",
  "description": "D&D 2024 规则的中文资源包：一座可以随时开团的边地铁镇「灰砧」、27 条资料（人物、地点、怪物、物品与传说，12 条玩家可见）和一张九地点关系地图。不含剧本。",
  "plugin_type": "content-pack",
  "license": "CC-BY-NC-4.0",
  "config_schema": "config.schema.json",
  "capabilities": [
    "content.world",
    "content.map"
  ],
  "permissions": [
    "content.read"
  ],
  "contributes": {
    "world_templates": [
      "content/worlds/*.json"
    ],
    "lorebooks": [
      "content/lorebooks/*.json"
    ],
    "map_definitions": [
      "maps/definitions/*.json"
    ],
    "map_locations": [
      "maps/locations/*.json"
    ]
  },
  "requires": {
    "rulesets": [
      {
        "id": "core:dnd2024"
      }
    ]
  },
  "docs": "README.md"
}
